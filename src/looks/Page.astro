---
// One entry point for every page of every look. route = "", "ai", "ydelser", "om", "kontakt", "fjernsupport",
// "privatliv", "indsigt", "en", "en/ai", "notfound" or "indsigt/<slug>" (with post).
// Titles/descriptions are shared across looks on purpose (stable SEO).
import { render } from "astro:content";
import LookBase from "./LookBase.astro";
import FrontL from "./FrontL.astro";
import FrontFocus from "./FrontFocus.astro";
import FrontK from "./FrontK.astro";
import FrontM from "./FrontM.astro";
import Inner from "./Inner.astro";
import AiDiagram from "./AiDiagram.astro";
import { copy, type Look } from "./lib";
interface Props { look: Look; route: string; post?: any }
const { look, route, post } = Astro.props;
const META: Record<string, [string | undefined, string]> = {
  "": ["AI-agenter og IT-drift for mindre virksomheder", "AI-agenter som digitale medarbejdere og en fast IT-partner til drift, sikkerhed og backup for små og mellemstore virksomheder."],
  en: ["AI agents and IT operations for small businesses", "AI agents that work as digital employees, plus a regular IT partner for operations, security and backup for small and mid-sized businesses."],
  ai: ["AI-agenter som digitale medarbejdere", "AI-agenter kan sortere henvendelser og skrive udkast til svar som digitale medarbejdere. Et menneske godkender, før noget sendes, ændres eller købes."],
  "en/ai": ["AI agents as digital employees", "AI agents can sort requests and draft replies as digital employees. A human approves before anything is sent, changed or bought."],
  ydelser: ["Ydelser", "Drift, IT-sikkerhed, backup, Microsoft 365 og infrastruktur. Vi tilbyder også AI-tjek, AI-sikring, AI-tilsyn og AI-start — priser fra 8.500 kr. ekskl. moms."],
  om: ["Om DataMatrix", "DataMatrix blev grundlagt i 2004 af Hans Kristiansen. Senior IT-rådgivning med fokus på sikkerhed, driftssikkerhed og bundlinje."],
  kontakt: ["Kontakt", "Kontakt DataMatrix: ring +45 2026 1188 eller skriv til kontakt@datamatrix.dk."],
  fjernsupport: ["Fjernsupport", "Fjernsupport fra DataMatrix: ring først, og hent derefter programmet, så vi kan se med på din skærm."],
  privatliv: ["Privatliv", "Privatlivspolitik for datamatrix.dk: ingen cookies, ingen sporing."],
  indsigt: ["Indsigt", "Korte artikler og nyheder fra DataMatrix om drift, sikkerhed og AI i praksis."],
  notfound: ["Siden findes ikke", "Siden blev ikke fundet."],
};
const isPost = route.startsWith("indsigt/") && post;
const [title, description] = isPost ? [post.data.title, post.data.description] : META[route];
const path = route === "" ? "/" : route === "notfound" ? "/404/" : `/${route}/`;
const Content = isPost ? (await render(post)).Content : null;
const Front = look === "l" ? FrontL : look === "k" ? FrontK : look === "m" ? FrontM : FrontFocus;
const front = route === "" || route === "en";
const englishAi = route === "en/ai";
const lang = route === "en" || englishAi ? "en" : "da";
const agent = englishAi ? copy(look).en.ai : null;
---
<LookBase look={look} lang={lang} title={title} description={description} path={path} solid={!front}>
  {front && <Front look={look} lang={lang} />}
  {!front && !isPost && !englishAi && <Inner look={look} page={route} />}
  {agent && <>
    <div class="page-hero"><div class="wrap">
      <h1>{agent.agentH}</h1>
      <p class="lead">{agent.agentP}</p>
    </div></div>
    <div class="inner"><div class="wrap">
      <div class="ai-vis"><AiDiagram variant="flow" lang="en" /></div>
    </div></div>
  </>}
  {isPost && Content && (
    <div class="page-hero" style="padding-bottom:30px"><div class="wrap">
      <span class="lab">Indsigt · {post.data.date.toLocaleDateString("da-DK", { day: "numeric", month: "long", year: "numeric" })}</span>
      <h1 style="font-size:clamp(2rem,4vw,3.2rem)">{post.data.title}</h1>
    </div></div>
    <div class="inner"><div class="wrap"><article class="article"><Content /><p style="margin-top:2em"><a href="/indsigt/">← Alle indlæg</a></p></article></div></div>
  )}
</LookBase>
