---
// Front page, look J "Lommelygte": dark server room, the cursor is a torch; AI story tabs; expanding service cards.
import Photo from "./Photo.astro";
import Blocks from "./Blocks.astro";
import EnAbout from "./EnAbout.astro";
import { copy, site } from "./lib";
interface Props { lang?: "da" | "en" }
const { lang = "da" } = Astro.props;
const look = "j";
const da = lang === "da";
const c = copy(look);
const f = da ? c.front : c.en.front;
const x = da ? c.extra : c.en.extra;
const short = site.phone.replace("+45 ", "");
const chips = ["Hermes Agent", "OpenClaw", da ? "Egen Grok-bot" : "Own Grok bot", "OpenAI Dots"];
const names = da
  ? { sikkerhed: "IT-sikkerhed", cloud: "Microsoft 365 og cloud", drift: "Drift og overvågning", backup: "Backup og beredskab" }
  : { sikkerhed: "IT security", cloud: "Microsoft 365 and cloud", drift: "Operations and monitoring", backup: "Backup and disaster recovery" };
const order = ["sikkerhed", "cloud", "drift", "backup"] as const;
---
<div class="hero-t" id="hero">
  <Photo look={look} slot="hero" class="dark" eager />
  <Photo look={look} slot="hero" class="lit" eager />
  <div class="warmth"></div>
  <div class="scene" aria-hidden="true"><div class="world" id="world"></div></div>
  <div class="in"><div class="wrap">
    <span class="lab">{f.hero.lab}</span>
    <h1>{f.hero.h1} <b>{f.hero.h1b}</b></h1>
    <p>{f.hero.lead}</p>
    <div class="acts"><a class="btn mag" href={site.phoneHref}>{da ? "Ring" : "Call"} {short} →</a><a class="btn o" href="#ai">{f.hero.cta2}</a></div>
  </div></div>
  <div class="hint" aria-hidden="true">{x.hint}</div>
</div>

<section id="ai"><div class="wrap">
  <div class="chap"><span class="lab">{f.ai.lab}</span><div><h2>{f.ai.h} <b>{f.ai.hb}</b></h2><p>{f.ai.p}</p></div></div>
  <div class="tabs" id="tabs" role="tablist">{x.tabs.map((t: string, i: number) => <button role="tab" class={i === 0 ? "on" : undefined} aria-selected={i === 0 ? "true" : "false"}>{t}<i></i></button>)}</div>
  <div class="stage" id="stage">
    <div class="pane on"><Photo look={look} slot="ai" /><div class="c">
      <h3>{x.paneH[0][0]} <b>{x.paneH[0][1]}</b></h3>
      <ul>{f.ai.caps.map(([t, p]: string[]) => <li><b>{t}.</b> {p}</li>)}</ul></div>
      <div class="glass"><Blocks kind="agent" look={look} f={f} lang={lang} /></div></div>
    <div class="pane"><Photo look={look} slot="approve" /><div class="c">
      <h3>{x.paneH[1][0]} <b>{x.paneH[1][1]}</b></h3>
      <p>{f.ai.helpP}</p>
      <ul>{f.ai.help.map(([t, p]: string[]) => <li><b>{t}.</b> {p}</li>)}</ul>
      <div class="rules">{f.ai.rules.map((r: string, i: number) => <span><b>{i + 1}</b>{r}</span>)}</div></div></div>
    <div class="pane"><Photo look={look} slot="runbook" /><div class="c">
      <h3>{x.paneH[2][0]} <b>{x.paneH[2][1]}</b></h3>
      <p><b style="color:#fff;font-weight:500">{f.ai.harnessH}</b> {f.ai.harnessP}</p>
      <div class="chips">{chips.map((n) => <span>{n}</span>)}</div>
      {da && <p style="margin-top:18px"><a href="/ai/">{x.tabs[0]} →</a></p>}</div></div>
  </div>
</div></section>

<section id="services" style="padding-top:40px"><div class="wrap">
  <div class="chap"><span class="lab">{f.services.lab}</span><div><h2>{f.services.h} <b>{f.services.hb}</b></h2><p>{f.services.p}</p></div></div>
  <div class="deck" id="deck">
    {order.map((key, i) => (
      <div class:list={["card", { on: i === 0 }]} tabindex="0">
        <Photo look={look} slot={key} sizes="(max-width:900px) 100vw, 60vw" />
        <div class="c"><span class="n">0{i + 2}</span><h3>{names[key]}</h3><p><b style="color:#fff;font-weight:500">{f.services.items[key].h} {f.services.items[key].hb}</b> {f.services.items[key].p}</p></div>
      </div>
    ))}
  </div>
  {da && <p style="margin-top:22px"><a href="/ydelser/">{f.services.lab.replace(/^\d+\s*·\s*/, "")} →</a></p>}
</div></section>

{!da && <EnAbout look={look} />}
<Blocks kind="why" look={look} f={f} lang={lang} />
<Blocks kind="cta" look={look} f={f} lang={lang} />
