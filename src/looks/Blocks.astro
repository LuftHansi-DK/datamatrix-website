---
// Small shared blocks for the front pages: agent console, why/person, CTA, services zigzag item.
import Photo from "./Photo.astro";
import { site, type Look } from "./lib";
interface Props { kind: "agent" | "why" | "cta"; look: Look; f: any; lang?: "da" | "en"; ctaSlot?: string }
const { kind, look, f, lang = "da", ctaSlot = "cta" } = Astro.props;
const da = lang === "da";
const a = f.agent;
const pad = (s: string) => s.padEnd(18, " ");
const L = da
  ? ["▸ ny henvendelse", "▸ triage", "▸ opgave", "▸ runbook", "▸ udkast", "▸ menneske"]
  : ["▸ new request", "▸ triage", "▸ task", "▸ runbook", "▸ draft", "▸ human"];
const lines = [
  ["k", pad(L[0])], ["h", `"${a.request.replace(/^["“”„«»]+|["“”„«»]+$/g, "")}"\n`],
  ["k", pad(L[1])], ["", a.triage + " "], ["w", a.prio], ["", "\n"],
  ["k", pad(L[2])], ["", a.task + "\n"],
  ["k", pad(L[3])], ["", a.runbook + "\n"],
  ["k", pad(L[4])], ["", a.draft + "\n"],
  ["k", pad(L[5])], ["o", a.human + "\n\n"], ["h", a.rule],
];
---
{kind === "agent" && <div class="agent" role="img" aria-label={`${a.request} → ${a.rule}`} data-lines={JSON.stringify(lines)}></div>}
{kind === "why" && (
  <section><div class="wrap person">
    <div class="pt"><img src="/img/hans.jpg" alt="Hans Kristiansen" width="350" height="350" loading="lazy" /></div>
    <div><span class="lab">{f.why.lab}</span>
      <blockquote>“{f.why.quote.replace(/^["“”„«»]+|["“”„«»]+$/g, "")}”</blockquote>
      <span class="who">Hans Kristiansen <span>· {f.why.role}</span></span>
      <div class="nums"><div><b>{new Date().getFullYear() - site.founded}</b>{f.why.nums[0]}</div><div><b>30+</b>{f.why.nums[1]}</div><div><b>1</b>{f.why.nums[2]}</div></div>
    </div>
  </div></section>
)}
{kind === "cta" && (
  <div class="cta" id={da ? undefined : "contact"}><div class="ph rf"><Photo look={look} slot={ctaSlot} /></div>
    <div class="wrap"><span class="lab">{f.cta.lab}</span><h2>{f.cta.h} <b>{f.cta.hb}</b></h2><p>{f.cta.p}</p>
      <div class="acts" style="justify-content:center"><a class="btn mag" href={site.phoneHref}>{da ? "Ring" : "Call"} {site.phone} →</a><a class="btn o" href={`mailto:${site.email}`}>{site.email}</a></div>
      {!da && <p class="note" style="margin-top:28px">{site.legalName} · {site.street} · {site.city}, Denmark · CVR {site.cvr}</p>}
    </div></div>
)}
