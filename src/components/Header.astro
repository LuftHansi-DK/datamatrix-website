---
import Logo from "./Logo.astro";
import site from "../data/site.json";
const { lang = "da" } = Astro.props;
const path = Astro.url.pathname;
const nav = lang === "da"
  ? [["/ydelser/", "Ydelser"], ["/ai/", "AI i drift"], ["/om/", "Om DataMatrix"], ["/indsigt/", "Indsigt"], ["/kontakt/", "Kontakt"]]
  : [["/en/#services", "Services"], ["/en/#ai", "AI"], ["/en/#about", "About"], ["/en/#contact", "Contact"]];
---
<header class="site-header">
  <div class="wrap bar">
    <a href={lang === "da" ? "/" : "/en/"} class="brand" aria-label="DataMatrix – forside">
      <Logo height={36} />
    </a>
    <input type="checkbox" id="navtoggle" class="navtoggle" aria-label="Menu" />
    <label for="navtoggle" class="burger" aria-hidden="true"><span></span><span></span><span></span></label>
    <nav aria-label="Hovedmenu">
      {nav.map(([href, label]) => (
        <a href={href} aria-current={path.startsWith(href) && href !== "/" ? "page" : undefined}>{label}</a>
      ))}
      <a class="lang" href={lang === "da" ? "/en/" : "/"} lang={lang === "da" ? "en" : "da"}>{lang === "da" ? "EN" : "DA"}</a>
      <a class="btn btn-small" href={site.phoneHref}>{site.phone}</a>
    </nav>
  </div>
</header>
